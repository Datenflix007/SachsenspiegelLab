{
  "_info": "Anker je § in Handschriftenreihenfolge (Lübben 1879). id = Artikel, s = §, a = Anfangsworte exakt wie im bereinigten OCR-Text. {end:true} schließt den geprüften Bereich ab. Geprüft: Prolog und Landrecht I (2026-11-19).",
  "landrecht": [
    { "id": "lr-prolog", "s": 1, "a": "Des hilighen geystes minne" },
    { "id": "lr-prolog", "s": 2, "a": "God is seinen regt" },
    { "id": "lr-prolog", "s": 3, "a": "God, de dar is begyn" },
    { "id": "lr-i-1", "s": 1, "a": "Twe swert let got" },
    { "id": "lr-i-2", "s": 1, "a": "Icwelieli kerstene man" },
    { "id": "lr-i-2", "s": 2, "a": "Tho geliker wis scolen" },
    { "id": "lr-i-2", "s": 3, "a": "De plecbaften sint plichtich" },
    { "id": "lr-i-2", "s": 4, "a": "De lanceten, de nin eghen" },
    { "id": "lr-i-3", "s": 1, "a": "Origenes wissagede" },
    { "id": "lr-i-3", "s": 2, "a": "To der suluen wis sint de herescilde" },
    { "id": "lr-i-3", "s": 3, "a": "Nu merke wi, war de sibbe" },
    { "id": "lr-i-4", "s": 1, "a": "Uppe altflle unde dwerghe" },
    { "id": "lr-i-5", "s": 1, "a": "Nimpt de sone wif" },
    { "id": "lr-i-5", "s": 2, "a": "De dochter, de in dem hus" },
    { "id": "lr-i-5", "s": 3, "a": "De pape nimpt liken del" },
    { "id": "lr-i-6", "s": 1, "a": "Mit soweliken gode" },
    { "id": "lr-i-6", "s": 2, "a": "De den dat erue nimpt" },
    { "id": "lr-i-6", "s": 3, "a": "Swat so auer en man wer" },
    { "id": "lr-i-6", "s": 4, "a": "Men sal och den eruen gelden" },
    { "id": "lr-i-7", "s": 1, "a": "Swe so gicht borghet" },
    { "id": "lr-i-8", "s": 1, "a": "Swar men auer eghen gift" },
    { "id": "lr-i-8", "s": 2, "a": "Des vronen boden getüch" },
    { "id": "lr-i-8", "s": 3, "a": "Sone vnde orueyde" },
    { "id": "lr-i-9", "s": 1, "a": "Swe auer den andren louet en eghen" },
    { "id": "lr-i-9", "s": 2, "a": "Swe oc den andren sin got uordinghet" },
    { "id": "lr-i-9", "s": 3, "a": "Dit snluc sal oc de here ton" },
    { "id": "lr-i-9", "s": 4, "a": "Louet auer de man, de" },
    { "id": "lr-i-9", "s": 5, "a": "Swc oc den andren göth an sine were" },
    { "id": "lr-i-9", "s": 6, "a": "Streft auer de gene, det laten solde" },
    { "id": "lr-i-10", "s": 1, "a": "Gift de vader sinen sonen" },
    { "id": "lr-i-11", "s": 1, "a": "Halt oc de uader sine kindere" },
    { "id": "lr-i-12", "s": 1, "a": "Swar brodere eder andere lüde" },
    { "id": "lr-i-13", "s": 1, "a": "Snnderet de uader" },
    { "id": "lr-i-13", "s": 2, "a": "Hadden se auer ire eruedelingbe" },
    { "id": "lr-i-14", "s": 1, "a": "Al si dat lenreebt" },
    { "id": "lr-i-14", "s": 2, "a": "Also nis och nin lantreebt" },
    { "id": "lr-i-15", "s": 1, "a": "Swe den anderen sin van" },
    { "id": "lr-i-15", "s": 2, "a": "Schuldeget men den man vmme dat" },
    { "id": "lr-i-16", "s": 1, "a": "Nin man ne mach irweruen ander recht" },
    { "id": "lr-i-16", "s": 2, "a": "Swar dat kint is vry und echte" },
    { "id": "lr-i-17", "s": 1, "a": "Streft de man ane kint" },
    { "id": "lr-i-17", "s": 2, "a": "De swauc ne mach oc uan wifhaluen" },
    { "id": "lr-i-18", "s": 1, "a": "Drierhande minschen recht" },
    { "id": "lr-i-18", "s": 2, "a": "dat ander: wat en man uor gherichte" },
    { "id": "lr-i-18", "s": 3, "a": "Dat dridde is" },
    { "id": "lr-i-19", "s": 1, "a": "De swaue nimpt wol herwede" },
    { "id": "lr-i-19", "s": 2, "a": "De swauen scheidet wol ordel" },
    { "id": "lr-i-20", "s": 1, "a": "Na uornemet, wat iewelik man" },
    { "id": "lr-i-20", "s": 2, "a": "Swar der urowen de stede" },
    { "id": "lr-i-20", "s": 3, "a": "Blift se auer mit den kindren" },
    { "id": "lr-i-20", "s": 4, "a": "Blift auer de wedewe" },
    { "id": "lr-i-20", "s": 5, "a": "Bcsterft auer de sone" },
    { "id": "lr-i-20", "s": 6, "a": "Morghengaue bihalt dat wif" },
    { "id": "lr-i-20", "s": 7, "a": "Dus behalt er niftele" },
    { "id": "lr-i-20", "s": 8, "a": "Alle de uan ridders art nicht ne sint" },
    { "id": "lr-i-20", "s": 9, "a": "Morgengaue behalt en wif uppen hiligen ane tuch" },
    { "id": "lr-i-21", "s": 1, "a": "Men mot ok wol vrowen eghen gheuen" },
    { "id": "lr-i-21", "s": 2, "a": "Liftucht ne kan den urowen" },
    { "id": "lr-i-22", "s": 1, "a": "De erue mot wol uaren to der wedewen" },
    { "id": "lr-i-22", "s": 2, "a": "Van dem erue sal men erst den inghesinne" },
    { "id": "lr-i-22", "s": 3, "a": "Dar na mot de urowe iegben" },
    { "id": "lr-i-22", "s": 4, "a": "So sal de urowe to berwede" },
    { "id": "lr-i-22", "s": 5, "a": "Swar * twe man eder die" },
    { "id": "lr-i-23", "s": 1, "a": "Swar de sonen binnen eren iaren" },
    { "id": "lr-i-23", "s": 2, "a": "Al si en kint to lenrechte" },
    { "id": "lr-i-24", "s": 1, "a": "Na den herwede sal dat wif" },
    { "id": "lr-i-24", "s": 2, "a": "Mesteswin boret auer" },
    { "id": "lr-i-24", "s": 3, "a": "So nimpt se al dat to der rade" },
    { "id": "lr-i-24", "s": 4, "a": "Wat des auer utestunt" },
    { "id": "lr-i-25", "s": 1, "a": "De pape delt mit den brodere" },
    { "id": "lr-i-25", "s": 2, "a": "Moneket men en kint" },
    { "id": "lr-i-25", "s": 3, "a": "Begift sie auer en" },
    { "id": "lr-i-25", "s": 4, "a": "Heuet auer he sie begheuen" },
    { "id": "lr-i-25", "s": 5, "a": "Streft en kint eder begift" },
    { "id": "lr-i-27", "s": 1, "a": "lewelich wif erft twier" },
    { "id": "lr-i-27", "s": 2, "a": "lewelich man uan ridders art" },
    { "id": "lr-i-28", "s": 1, "a": "So wat sodanes dinghes" },
    { "id": "lr-i-29", "s": 1, "a": "An eghene unde an höue" },
    { "id": "lr-i-30", "s": 1, "a": "lewelich incomen man" },
    { "id": "lr-i-31", "s": 1, "a": "Man unde wif ne hebbet nin" },
    { "id": "lr-i-31", "s": 2, "a": "Swen en man wif nimpt" },
    { "id": "lr-i-32", "s": 1, "a": "Nin wif ne mach oc to egene" },
    { "id": "lr-i-33", "s": 1, "a": "Nu uornemet um en wif" },
    { "id": "lr-i-34", "s": 1, "a": "Ane des richters orlof" },
    { "id": "lr-i-34", "s": 2, "a": "Swelich man sin eghen gift unde dat weder" },
    { "id": "lr-i-34", "s": 3, "a": "Erret de richtere" },
    { "id": "lr-i-35", "s": 1, "a": "Al schat under der erden" },
    { "id": "lr-i-35", "s": 2, "a": "Süluer ne mot nin man breken" },
    { "id": "lr-i-36", "s": 1, "a": "Swen dat wif erst nimpt man" },
    { "id": "lr-i-36", "s": 2, "a": "Wint se kint na eres mannes dode" },
    { "id": "lr-i-37", "s": 1, "a": "Swe so enes mannes wif" },
    { "id": "lr-i-38", "s": 1, "a": "Kempen unde ere kindere" },
    { "id": "lr-i-38", "s": 2, "a": "De iar unde dach in des rikes achte sin" },
    { "id": "lr-i-38", "s": 3, "a": "Echte kindere mach de vnechte" },
    { "id": "lr-i-39", "s": 1, "a": "De crc recht mit roue" },
    { "id": "lr-i-40", "s": 1, "a": "Swe tiüelos beredet wirt" },
    { "id": "lr-i-41", "s": 1, "a": "Claghet magbet eder Avedcwe" },
    { "id": "lr-i-42", "s": 1, "a": "Er sinen daghen unde na sinen daghen" },
    { "id": "lr-i-42", "s": 2, "a": "Swen dat kint to sinen iaren cumpt" },
    { "id": "lr-i-43", "s": 1, "a": "An notnüuftigher claghe" },
    { "id": "lr-i-44", "s": 1, "a": "Claghet magbet eder wedewe to lantrechte ouer eren uoremünden. dat be" },
    { "id": "lr-i-45", "s": 1, "a": "Alne si en man sinen wiue" },
    { "id": "lr-i-45", "s": 2, "a": "En wif ne mach oc ane eres mannes ghelof" },
    { "id": "lr-i-46", "s": 1, "a": "Magbet unde wif moten uoremünden" },
    { "id": "lr-i-47", "s": 1, "a": "Swar it den urowen to eden" },
    { "id": "lr-i-47", "s": 2, "a": "De uoremunde uan richtes baluen" },
    { "id": "lr-i-48", "s": 1, "a": "Alle de unechte gheboren sin eder" },
    { "id": "lr-i-48", "s": 2, "a": "Lame lüde solen antworden" },
    { "id": "lr-i-48", "s": 3, "a": "Weret auer lie sie mit kempen" },
    { "id": "lr-i-49", "s": 1, "a": "Sprekt en ghewundet man" },
    { "id": "lr-i-50", "s": 1, "a": "Swe oc den andren wundet eder dodet" },
    { "id": "lr-i-50", "s": 2, "a": "Al si en man speleman" },
    { "id": "lr-i-51", "s": 1, "a": "It is manich man rechtlos" },
    { "id": "lr-i-51", "s": 2, "a": "Men seghet, dat nin kint" },
    { "id": "lr-i-51", "s": 3, "a": "Swelich man van sinen ucr anen" },
    { "id": "lr-i-51", "s": 4, "a": "Swelich schepenbare vri man" },
    { "id": "lr-i-51", "s": 5, "a": "Swe sie des andren underwint mit campe" },
    { "id": "lr-i-52", "s": 1, "a": "Ane eruen ghelof uncle" },
    { "id": "lr-i-52", "s": 2, "a": "Alle uarende haue gift en man" },
    { "id": "lr-i-52", "s": 3, "a": "Swat he auer gheuen ghenomen" },
    { "id": "lr-i-52", "s": 4, "a": "Swe in siner suke" },
    { "id": "lr-i-53", "s": 1, "a": "Swe so nicht ne uolget" },
    { "id": "lr-i-53", "s": 2, "a": "Sprikt de man göd an" },
    { "id": "lr-i-53", "s": 3, "a": "Swe wedde unde böte nicht ne gift" },
    { "id": "lr-i-53", "s": 4, "a": "Nin man ne weddet vm ene" },
    { "id": "lr-i-54", "s": 1, "a": "It ne sal nin tinsman" },
    { "id": "lr-i-54", "s": 2, "a": "Swe sinen tins to rechten daghen" },
    { "id": "lr-i-54", "s": 3, "a": "Tins mot de herre eder sin bode" },
    { "id": "lr-i-54", "s": 4, "a": "De herre mot wol panden" },
    { "id": "lr-i-54", "s": 5, "a": "Nin tinsman ne mot och" },
    { "id": "lr-i-55", "s": 1, "a": "Al werldlich richte heuet" },
    { "id": "lr-i-55", "s": 2, "a": "Beieghenet auer en hanthafte dat" },
    { "id": "lr-i-56", "s": 1, "a": "An goschap nis mit rechte" },
    { "id": "lr-i-57", "s": 1, "a": "Ne wirt de def eder de rotiere" },
    { "id": "lr-i-58", "s": 1, "a": "Swen men auer kuset to langer tid" },
    { "id": "lr-i-58", "s": 2, "a": "Also is des greuen, wanne de coningh" },
    { "id": "lr-i-59", "s": 1, "a": "Alle claghe unde al ungherichte" },
    { "id": "lr-i-59", "s": 2, "a": "It ne mach nin greue" },
    { "id": "lr-i-60", "s": 1, "a": "En man mot wol ane uorespraken" },
    { "id": "lr-i-60", "s": 2, "a": "De richtere sal to uorespraken gheuen" },
    { "id": "lr-i-61", "s": 2, "a": "Biddet twe man uorespraken" },
    { "id": "lr-i-61", "s": 3, "a": "De stamerc man" },
    { "id": "lr-i-61", "s": 4, "a": "Iewelik man mot wol uoresprake sin" },
    { "id": "lr-i-60", "s": 3, "a": "Swar de man recht uorderet" },
    { "id": "lr-i-61", "s": 1, "a": "Nin claghere ne darf borgben" },
    { "id": "lr-i-61", "s": 5, "a": "Swen de man to uorespraken nimpt" },
    { "id": "lr-i-62", "s": 1, "a": "Men ne sal nemende dwinghen" },
    { "id": "lr-i-62", "s": 2, "a": "Swe sin swert tud" },
    { "id": "lr-i-62", "s": 3, "a": "Umme blöt gheruchte" },
    { "id": "lr-i-62", "s": 4, "a": "Vuluorderet he auer sine claghe" },
    { "id": "lr-i-62", "s": 5, "a": "Ne wet hes uredebrekers namen" },
    { "id": "lr-i-62", "s": 6, "a": "Ghetüghes sal men ouer ses wehen" },
    { "id": "lr-i-62", "s": 7, "a": "De riehtere sal iümber den man" },
    { "id": "lr-i-62", "s": 8, "a": "Swelikes ordels men erst bedet" },
    { "id": "lr-i-62", "s": 9, "a": "De claghere unde uppe den de claghe gad" },
    { "id": "lr-i-62", "s": 10, "a": "In allen Steden is gherichte" },
    { "id": "lr-i-62", "s": 11, "a": "Openbare ne sal de man" },
    { "id": "lr-i-63", "s": 1, "a": "Swe campliken groten wil" },
    { "id": "lr-i-63", "s": 2, "a": "So spreke he uort" },
    { "id": "lr-i-63", "s": 3, "a": "Iewelik man mach campes weygheren" },
    { "id": "lr-i-63", "s": 4, "a": "De richtere sal twe boden gheuen" },
    { "id": "lr-i-63", "s": 5, "a": "De claghere sal erst in den warf" },
    { "id": "lr-i-64", "s": 1, "a": "Dus sal men oc uerwinnen enen doden" },
    { "id": "lr-i-65", "s": 1, "a": "Also hir uore gheredet is" },
    { "id": "lr-i-65", "s": 2, "a": "Swe lif eder hant ledeghet" },
    { "id": "lr-i-65", "s": 3, "a": "Swe oc borghet enen man" },
    { "id": "lr-i-65", "s": 4, "a": "Wcregelt gelt man" },
    { "id": "lr-i-66", "s": 1, "a": "Swen men in der hanthaften dat" },
    { "id": "lr-i-66", "s": 2, "a": "Also dot men den ueruesten man" },
    { "id": "lr-i-66", "s": 3, "a": "Doch ne sal men nemende uerdelen" },
    { "id": "lr-i-67", "s": 1, "a": "Swen men uor gherichte uorclaghet" },
    { "id": "lr-i-67", "s": 2, "a": "Swe nicht uore ne cumpt" },
    { "id": "lr-i-68", "s": 1, "a": "Dor anders nine clagke" },
    { "id": "lr-i-68", "s": 2, "a": "Swe auer den andren mit cnuppelen" },
    { "id": "lr-i-68", "s": 3, "a": "Mit der blodighen wunden" },
    { "id": "lr-i-68", "s": 4, "a": "Ane uleschwunden mach men" },
    { "id": "lr-i-68", "s": 5, "a": "Umbe wellekerhande schult" },
    { "id": "lr-i-69", "s": 1, "a": "Swe oc enen doden eder enen ghewundeden" },
    { "id": "lr-i-70", "s": 1, "a": "Heuet auer de man gheclaghet" },
    { "id": "lr-i-70", "s": 2, "a": "Claghet men auer vmme schult" },
    { "id": "lr-i-70", "s": 3, "a": "Swe clor ungherichte" },
    { "id": "lr-i-71", "s": 1, "a": "Swen de ghecorne gogreue" },
    { "end": true, "a": "War uorsten eder heren mit eden" }
  ],
  "lehnrecht": []
}
