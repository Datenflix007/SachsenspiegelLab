   "a": "Ouene unde ganghe unde swinecouen"
  },
  {
   "id": "lr-ii-51",
   "s": 2,
   "a": "Manlik sal oc beschuren sicen"
  },
  {
   "id": "lr-ii-51",
   "s": 3,
   "a": "Ganghe sal men oc werken"
  },
  {
   "id": "lr-ii-52",
   "s": 1,
   "a": "Vlechtet de hoppe ouer den"
  },
  {
   "id": "lr-ii-52",
   "s": 2,
   "a": "Sinei* bome telghen ne solen"
  },
  {
   "id": "lr-ii-53",
   "s": 1,
   "a": "Swat de man heuet uppe"
  },
  {
   "id": "lr-ii-54",
   "s": 1,
   "a": "De man ne sal sin"
  },
  {
   "id": "lr-ii-54",
   "s": 2,
   "a": "Niman ne mot ok sunderliken"
  },
  {
   "id": "lr-ii-54",
   "s": 3,
   "a": "SWar men aaer den berden"
  },
  {
   "id": "lr-ii-54",
   "s": 4,
   "a": "Swat men uor den berden"
  },
  {
   "id": "lr-ii-54",
   "s": 5,
   "a": "Belemet en ue dat andere"
  },
  {
   "id": "lr-ii-54",
   "s": 6,
   "a": "Sebuldegbet men den herden, dat"
  },
  {
   "id": "lr-ii-55",
   "s": 1,
   "a": "Swat so de burmester sebipt"
  },
  {
   "id": "lr-ii-56",
   "s": 1,
   "a": "Swelich dorp bi watere legbet"
  },
  {
   "id": "lr-ii-56",
   "s": 2,
   "a": "Swat dat water alscbauct den"
  },
  {
   "id": "lr-ii-56",
   "s": 3,
   "a": "Swelik werder sie irheuet in"
  },
  {
   "id": "lr-ii-57",
   "s": 1,
   "a": "Alne si en god manighes"
  },
  {
   "id": "lr-ii-58",
   "s": 1,
   "a": "Ofte de man na dode"
  },
  {
   "id": "lr-ii-58",
   "s": 2,
   "a": "Nu uernemet, wan it uordenet"
  },
  {
   "id": "lr-ii-58",
   "s": 3,
   "a": "Behalt dat kint sine iartale"
  },
  {
   "id": "lr-ii-59",
   "s": 1,
   "a": "Wil en herre wisen sinen"
  },
  {
   "id": "lr-ii-59",
   "s": 2,
   "a": "Steift de tinsman des berren,"
  },
  {
   "id": "lr-ii-59",
   "s": 3,
   "a": "Des coninghes strate sal sin"
  },
  {
   "id": "lr-ii-59",
   "s": 4,
   "a": "De erst to der molen"
  },
  {
   "id": "lr-ii-60",
   "s": 1,
   "a": "Swelich man enen andren lent"
  },
  {
   "id": "lr-ii-60",
   "s": 2,
   "a": "Steiß auer ghene, rechtes dodes"
  },
  {
   "id": "lr-ii-61",
   "s": 1,
   "a": "Do got den miuschen scop,"
  },
  {
   "id": "lr-ii-61",
   "s": 2,
   "a": "Doch sin die stede in"
  },
  {
   "id": "lr-ii-61",
   "s": 3,
   "a": "Swe dor den banuorst rid"
  },
  {
   "id": "lr-ii-61",
   "s": 4,
   "a": "Iaghet en man wild buten"
  },
  {
   "id": "lr-ii-61",
   "s": 5,
   "a": "Niman ne mot de sat"
  },
  {
   "id": "lr-ii-62",
   "s": 1,
   "a": "Swe halt enen glumenden himt"
  },
  {
   "id": "lr-ii-62",
   "s": 2,
   "a": "Sleyt en man enen hunt"
  },
  {
   "id": "lr-ii-62",
   "s": 3,
   "a": "Swe wilde der heghen wil"
  },
  {
   "id": "lr-ii-63",
   "s": 1,
   "a": "It ne mach nin wif"
  },
  {
   "id": "lr-ii-63",
   "s": 2,
   "a": "lewelich man de mot wol uoresprake"
  },
  {
   "id": "lr-ii-64",
   "s": 1,
   "a": "Wif eder maget, de not"
  },
  {
   "id": "lr-ii-64",
   "s": 2,
   "a": "De oc mit duue eder"
  },
  {
   "id": "lr-ii-64",
   "s": 3,
   "a": "De oc doden uor richte"
  },
  {
   "id": "lr-ii-64",
   "s": 4,
   "a": "De oe berouet is unde"
  },
  {
   "id": "lr-ii-64",
   "s": 5,
   "a": "Swar nin lianthafte dat nis,"
  },
  {
   "id": "lr-ii-65",
   "s": 1,
   "a": "Nin kint nc mach binnen"
  },
  {
   "id": "lr-ii-65",
   "s": 2,
   "a": "Sleyt auer en man cn"
  },
  {
   "id": "lr-ii-66",
   "s": 1,
   "a": "Nu uornemet den alden urede,"
  },
  {
   "id": "lr-ii-66",
   "s": 2,
   "a": "Hilgbe daghe unde gbebundene daghe"
  },
  {
   "id": "lr-ii-67",
   "s": 1,
   "a": "Swe dorch ungherichte beclaghet wiit,"
  },
  {
   "id": "lr-ii-68",
   "s": 1,
   "a": "Irleghet enen manne, de wechuerdich"
  },
  {
   "id": "lr-ii-69",
   "s": 1,
   "a": "Swe dodet eder wundet enen"
  },
  {
   "id": "lr-ii-70",
   "s": 1,
   "a": "Men ne sal nymanne wisen"
  },
  {
   "id": "lr-ii-71",
   "s": 1,
   "a": "Swe den urede briet, dat"
  },
  {
   "id": "lr-ii-71",
   "s": 2,
   "a": "Binnen sworenen urede sal men"
  },
  {
   "id": "lr-ii-71",
   "s": 3,
   "a": "Wapen mot men oc uoren,"
  },
  {
   "id": "lr-ii-71",
   "s": 4,
   "a": "Ofte se uolghet uor ene"
  },
  {
   "id": "lr-ii-71",
   "s": 5,
   "a": "Vlut auer he to dorpe,"
  },
  {
   "id": "lr-ii-72",
   "s": 1,
   "a": "Vppe weliker horch men de"
  },
  {
   "id": "lr-ii-72",
   "s": 2,
   "a": "Schuldeghet men de horch umme"
  },
  {
   "id": "lr-ii-72",
   "s": 3,
   "a": "Ouer wen men claghet, dat"
  },
  {
   "id": "lr-ii-72",
   "s": 4,
   "a": "Claghet auer en man ouer"
  },
  {
   "id": "lr-ii-72",
   "s": 5,
   "a": "Ridet lüde uan ener horch"
  },
  {
   "end": true,
   "a": "Vinme niner hande ungherichte"
  }
 ],
 "lehnrecht": []
}